<?xml version="1.0" encoding="utf-8"?>
<installer-gui-script minSpecVersion="2">
    <title>Toilet Vocals __VERSION__</title>
    <welcome file="welcome.html" mime-type="text/html"/>
    <options customize="allow" require-scripts="false" hostArchitectures="arm64,x86_64"/>
    <domains enable_localSystem="true"/>
    <os-version min="11.0"/>

    <choices-outline>
        <line choice="au"/>
        <line choice="vst3"/>
        <line choice="app"/>
    </choices-outline>

    <choice id="au" title="Audio Unit (Logic, GarageBand, Ableton, ...)" description="Installs to /Library/Audio/Plug-Ins/Components">
        <pkg-ref id="com.porcelainaudio.toiletvocals.au"/>
    </choice>
    <choice id="vst3" title="VST3" description="Installs to /Library/Audio/Plug-Ins/VST3">
        <pkg-ref id="com.porcelainaudio.toiletvocals.vst3"/>
    </choice>
    <choice id="app" title="Standalone app" description="Installs Toilet Vocals.app to /Applications">
        <pkg-ref id="com.porcelainaudio.toiletvocals.app"/>
    </choice>

    <pkg-ref id="com.porcelainaudio.toiletvocals.au" version="__VERSION__" onConclusion="none">au.pkg</pkg-ref>
    <pkg-ref id="com.porcelainaudio.toiletvocals.vst3" version="__VERSION__" onConclusion="none">vst3.pkg</pkg-ref>
    <pkg-ref id="com.porcelainaudio.toiletvocals.app" version="__VERSION__" onConclusion="none">app.pkg</pkg-ref>
</installer-gui-script>
